# Copy this file to `.env` in the project root (same folder as pubspec.yaml).
# Web builds bundle this file as an asset — keep a real `.env` there before `flutter run -d chrome`.
# Lines starting with # are comments (flutter_dotenv).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Must match Postgres enum app_role exactly (run supabase/query_app_role_enum.sql to list).
PROFILE_ROLE_STUDENT=Student
