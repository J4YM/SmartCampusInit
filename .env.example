# Copy this file to `.env` in the project root (same folder as pubspec.yaml).
# Web builds bundle this file as an asset — keep a real `.env` there before `flutter run -d chrome`.
# Lines starting with # are comments (flutter_dotenv).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Must match Postgres enum app_role exactly (run supabase/query_app_role_enum.sql to list).
PROFILE_ROLE_STUDENT=Student

# Base URL of the deployed dropout-risk prediction service (see
# `Behavioral AI Model/run_api.py`). Leave blank to fall back to demo data in
# the Guidance Counselor dashboard.
ML_API_BASE_URL=https://your-ml-api-host.example.com

# X-API-Key sent to the ML service's /retrain and /retrain/status endpoints
# (matched server-side against RETRAIN_API_KEY on that service). Leave blank
# to keep the Admin ML & Thresholds page's "Retrain Model Now" button
# disabled. NOTE: this ships inside the compiled Flutter web bundle like
# every other value here — anyone who inspects the built JS can extract it
# and call /retrain directly. Accepted for now; harden later with a Supabase
# Edge Function that proxies the call and checks the caller's Admin role
# server-side instead.
ML_RETRAIN_API_KEY=

# Base URL of the standalone slip-lookup web build (lib/main_slip.dart),
# deployed separately from the main app — see netlify.toml. Used to build
# the admission slip's QR code as `$SLIP_BASE_URL/slip/<id>`. Leave blank to
# hide the QR code on the slip preview screen entirely.
SLIP_BASE_URL=
