# attendance_display/.env.example
SUPABASE_URL=
SUPABASE_ANON_KEY=
SERVICE_EMAIL=attendance-display@internal.local
SERVICE_PASSWORD=
READER_USB_SERIAL=ATTENDANCE-ENTRANCE-001

# USB HID vendor/product id of the entrance reader, for the Windows Raw
# Input capture (Task 7). Read these off Device Manager -> reader device
# -> Properties -> Details -> Hardware Ids (format VID_xxxx&PID_xxxx).
# Optional: if unset, the app falls back to the focus-based text field
# capture from Task 6.
READER_VENDOR_ID=
READER_PRODUCT_ID=

# Only helps when another device sharing the same vendor/product id might
# also be connected to this PC (e.g. a second reader unit used by the
# kiosk app) AND Windows' Raw Input device list actually lists both as
# separate entries. Tested against two genuinely identical reader units
# (same model/firmware): Windows collapsed them to a single Raw Input
# entry no matter which was connected more recently, and this hint could
# not recover the other -- it was simply absent from the device list, not
# merely filtered out here. If your two readers are that similar, leave
# this blank and see attendance_display/README.md's reader-disambiguation
# section for real alternatives (different reader models, separate host
# PCs, or the focus-based fallback plus a configured prefix) instead.
#
# If your two readers DO show up as separate Raw Input entries: this is a
# case-insensitive substring matched against this specific unit's device
# path; find it by running, in PowerShell, with ONLY this reader's
# Hardware Ids matching READER_VENDOR_ID/READER_PRODUCT_ID above:
#   Get-PnpDevice -PresentOnly | Where-Object { $_.InstanceId -like "*VID_xxxx&PID_xxxx*MI_00*" }
# and copying the segment after the last backslash (e.g. 9&12e896f4&0&0000
# from HID\VID_xxxx&PID_xxxx&MI_00\9&12e896f4&0&0000) -- or just the
# distinguishing part of it. Tied to whichever USB port this unit is
# plugged into; re-check if it's ever moved to a different port.
READER_INSTANCE_HINT=

# A character prefix the entrance reader emits at the start of each tap
# (only if the physical reader model supports configuring a distinct
# prefix character — check its documentation/config utility). If set, any
# incoming input that doesn't start with this exact character is discarded
# as a likely misdirected tap from a different reader. Optional: leave
# blank if the reader doesn't support this or you haven't configured one —
# every input then passes through unchanged.
READER_PREFIX=
